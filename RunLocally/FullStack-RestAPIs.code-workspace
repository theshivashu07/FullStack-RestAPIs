{
  "folders": [
    {
      "name": "FullStack-RestAPIs",
      "path": ".."
    }
  ],
  "settings": {
    "task.allowAutomaticTasks": "on",
    "terminal.integrated.defaultProfile.windows": "Windows PowerShell",
    "terminal.integrated.tabs.enabled": true
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "START ALL DEVELOPMENT TERMINALS",
        "dependsOn": [
          "Docker + PostgreSQL",
          "Backend - Django + DRF",
          "Frontend - React.js",
          "Project GitHub Push"
        ],
        "dependsOrder": "parallel",
        "runOptions": {
          "runOn": "folderOpen"
        }
      },
      {
        "label": "Docker + PostgreSQL",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NoExit",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/RunLocally/scripts/Start-Postgres.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
          "showReuseMessage": false,
          "close": false
        }
      },
      {
        "label": "Backend - Django + DRF",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NoExit",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/RunLocally/scripts/Start-Backend.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
          "showReuseMessage": false,
          "close": false
        }
      },
      {
        "label": "Frontend - React.js",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NoExit",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/RunLocally/scripts/Start-Frontend.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
          "showReuseMessage": false,
          "close": false
        }
      },
      {
        "label": "Project GitHub Push",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NoExit",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/RunLocally/scripts/Check-Git.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
          "showReuseMessage": false,
          "close": false
        }
      }
    ]
  }
}
